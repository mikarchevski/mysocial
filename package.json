{
  "name": "mysocial-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch src/index.ts\" \"sass --watch --poll public/scss/main.scss public/css/style.css\"",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "sass": "sass public/scss/main.scss public/css/style.css",
    "sass:watch": "sass --watch public/scss/main.scss public/css/style.css"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.4",
    "drizzle-kit": "^0.31.10",
    "sass": "^1.104.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
